# TimeLink 前端設定（所有配置類項目都在這個檔案，fork 後直接修改即可）
# 修改後要重新啟動 dev server 或重新 build 才會生效。

# ── API ────────────────────────────────────────────────────────────────
# 後端查詢服務的網址。自己架設後端時改成自己的網址（含結尾斜線可省略）
VITE_TDX_BASE_URL=https://tdx.jiapi.net
# 單次 API 逾時（毫秒）
VITE_API_TIMEOUT=30000

# ── 產品與組織 ─────────────────────────────────────────────────────────
# 產品名稱（顯示於頁首、頁尾與瀏覽器標題）
VITE_APP_NAME=接軌時刻
# 產品副標題
VITE_APP_SUBTITLE=TimeLink
# 發行單位／所屬組織
VITE_ORG_NAME=極光駭客
# 顯示用的版本號
VITE_APP_VERSION=0.1.0
# 首頁與聯絡信箱（頁尾顯示；留空則不顯示）
VITE_HOMEPAGE_URL=https://tdx.jiapi.net/
VITE_CONTACT_EMAIL=

# ── 資料來源與授權 ─────────────────────────────────────────────────────
VITE_DATA_SOURCE_NAME=TDX 運輸資料流通服務平臺
VITE_DATA_SOURCE_URL=https://tdx.transportdata.tw/
VITE_LICENSE_NAME=政府資料開放授權條款
VITE_LICENSE_URL=https://data.gov.tw/license

# ── 預設查詢條件 ───────────────────────────────────────────────────────
# 出發站／到達站（車站代碼，例如 TRA-1000）
VITE_DEFAULT_FROM_STATION=TRA-1000
VITE_DEFAULT_TO_STATION=TRA-0960
# 乘車時間區間
VITE_DEFAULT_START_TIME=07:00
VITE_DEFAULT_END_TIME=09:00
# 星期幾：auto＝今天，或 0（星期日）～6（星期六）
VITE_DEFAULT_WEEK=auto
# 查詢結果預設顯示幾筆
VITE_DEFAULT_RESULT_LIMIT=10
# 「選擇路由」視窗：路由清單最多列幾條、一次最多勾幾條、以指定路由查詢時回傳幾筆
VITE_ROUTE_LIST_LIMIT=50
VITE_MAX_PICKED_ROUTES=10
VITE_PICKED_RESULT_LIMIT=50

# ── 限制 ──────────────────────────────────────────────────────────────
# 查詢時段最長幾分鐘（與後端限制一致）
VITE_MAX_RANGE_MINUTES=180
# 站名搜尋預設幾筆
VITE_STATION_SEARCH_LIMIT=10

# ── 開發用 ────────────────────────────────────────────────────────────
# dev server 連接埠
VITE_DEV_PORT=5173
# 開發模式使用同源 /txapi 時，proxy 要轉到的後端網址
VITE_DEV_PROXY_TARGET=https://tdx.jiapi.net

# ── 選用 ──────────────────────────────────────────────────────────────
# Google Analytics measurement ID（留空代表不載入）
VITE_GA_ID=
